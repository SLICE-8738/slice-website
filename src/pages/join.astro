---
import InfoLayout from "../layouts/InfoLayout.astro";
import "../styles/global.css";
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const interestAreas = [
  "Mechanical & building",
  "Electrical & Wiring",
  "Programming",
  "CAD",
  "Business & Fundraising",
  "Outreach & Marketing",
];
---

<InfoLayout
  title="Join Our Team"
  description="New members are always welcome -- no experience required."
>
  <section>
    <p class="lead">
      New members are always welcome! Our season officially kicks
      off in January, but we're active year-round. We recommend
      joining before the start of the season so you can be trained
      on the subteam of your choosing.
    </p>
  </section>

  <section>
    <p class="eyebrow">Interest Areas</p>
    <h2 class="section-title">Where You Could Fit In</h2>
    <div class="grid grid-3">
      <div class="card">
        <h3>Engineering</h3>
        <p>
          The engineering subteams are responsible for designing,
          building, and programming the robot. We work collaboratively
          utilizing CAD software, cnc machines, 3d printers, and WPIlib JAVA
          to create a competitive robot each for each year's game.
        </p>
        <div class=".tag-row" style="margin-top: auto;">
          <span class="tag accent">Mechanical</span>
          <span class="tag accent">Electrical</span>
          <span class="tag accent">Programming</span>
          <span class="tag accent">CAD</span>
        </div>
      </div>
      <div class="glass card" style="margin-top: auto;">
        <h3>Business</h3>
        <p>
          The business subteams are responsible for fundraising,
          marketing, and outreach. We work to ensure the team has 
          the resources it needs to succeed, and to spread the word 
          about SLICE and FIRST in our community.
        </p>
        <div class=".tag-row" style="margin-top: auto;">
          <span class="tag accent">Fundraising</span>
          <span class="tag accent">Marketing</span>
          <span class="tag accent">Outreach</span>
        </div>
      </div>
      <div class="card">
        <h3>Operations</h3>
        <p>
          The operations subteams are responsible for managing the
          team, including strategy, build space organization & logistics, field assembly, and safety.
          The strategy subteam works with engineering to determine the best way to play each year's game.
        </p>
        <div class=".tag-row">
          <span class="tag accent">Build Space</span>
          <span class="tag accent">Strategy</span>
          <span class="tag accent">Safety</span>
        </div>
      </div>
    </div>
  </section>

  <section>
    <p class="eyebrow">Meetings</p>
    <h2 class="section-title">When We Meet</h2>
    <p>
      We meet in Fuquay-Varina, North Carolina --
      <a href={`${base}contact/`}>contact us</a> for schedule and location.
      Meetings run from 2:30-3:30 in the offseason and 2:30-4:30
      during build season, though meeting days are subject to
      change.
    </p>
  </section>

  <section>
    <aside class="callout">
      <p class="eyebrow">Ready to Join?</p>
      <h3>Get Started</h3>
      <p>
        Reach out through our <a href={`${base}contact/`} style="color: var(--accent);">contact page</a> to
        ask about joining, or show up to any one of our meetings in room 1510 at Fuquay-Varina High School. We can't wait to meet you!
      </p>
      <a class="button primary" href={`${base}contact/`}>Contact Us -></a>
    </aside>
  </section>
</InfoLayout>
