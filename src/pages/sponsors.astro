---
// sponsors.astro
// Real sponsor logos exist on the live site's "Our Sponsors" page
// (2025-2026 season) but it's a flat logo row with no visible tier
// labels in the page text/markup, and 3 of the 6 logo files have no
// identifying filename -- so tiers below are PLACEHOLDER guesses
// and 3 names are PLACEHOLDER too. The 3 confirmed real sponsors
// (from image filenames) are Caterpillar, the Gene Haas Foundation,
// and TE Connectivity.
import MeetUsLayout from "../layouts/MeetUsLayout.astro";
import PayPalDonate from "../components/PayPalDonate.astro";
import "../styles/global.css";
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const sponsors = [
  { tier: "Peel Sponsor", name: "Fabworks", link: "https://www.fabworks.com/", background: "rgb(255, 255, 255)" },
  { tier: "Sponsor", name: "Waiting on 2027 Season Sponsors", link: "", background: "" },
  { tier: "Sponsor", name: "Waiting on 2027 Season Sponsors", link: "", background: "" },
  { tier: "Sponsor", name: "Waiting on 2027 Season Sponsors", link: "", background: "" },
  { tier: "Sponsor", name: "Waiting on 2027 Season Sponsors", link: "", background: "" },
  { tier: "Sponsor", name: "Waiting on 2027 Season Sponsors", link: "", background: "" },
];
---

<MeetUsLayout
  title="Current Sponsors"
  description="The sponsors who make SLICE's season possible."
>
  <section>
    <p class="lead">
      Every dollar donated is critical to our team's success --
      thank you to our current sponsors for making our season
      possible.
    </p>
  </section>

  <section class="grid grid-3">
    {sponsors.map((sponsor) => {
      const sponsorNameSlug = sponsor.name.toLowerCase().replace(/\s+/g, "-");
      const sponsorLogoExists = sponsor.name !== "Waiting on 2027 Season Sponsors";
      return (
        <div class="card">
          <div class="image" style={`background: ${sponsor.background ?? "var(--bg)"}`}>
            {sponsorLogoExists ? (
              <img src={`${base}images/sponsors/${sponsorNameSlug}.svg`} alt={sponsor.name} />
            ) : (
              <span class="sponsor-placeholder-text">Your logo here!</span>
            )}
          </div>
          <p class="eyebrow">{sponsor.tier}</p>
          <h3>{sponsor.name}</h3>
          <p><a href={sponsor.link} target="_blank" rel="noopener noreferrer" style="color: var(--accent-3);">Visit Website &#8599;</a></p>
        </div>
      );
    })}
  </section>

  <section>
    <aside class="callout">
        <div>
          <p class="eyebrow">Donate to SLICE</p>
          <h3>Support Our Team</h3>
          <p>
            Every donation helps us build our robot, travel to competitions,
            and run STEM outreach events in our community.
          </p>
          <PayPalDonate />
        </div>
        <div>
          <a href={base + "sponsor-us/"} class="button primary" style="margin-top: 1rem;">
            Sponsor Us
          </a>
        </div>
    </aside>
  </section>
</MeetUsLayout>
