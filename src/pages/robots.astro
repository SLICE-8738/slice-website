---
// robots.astro
// FIX: cards previously linked to `/robots/${slug}` with no base
// path, so on the deployed site (base: "/slice-website/") every
// card 404'd. Using the same sitePath() helper the rest of the
// site uses fixes that -- this is what "make the cards work" meant.
import GalleryLayout from "../layouts/GalleryLayout.astro";
import "../styles/global.css";
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const sitePath = (path: string) => {
  const cleanPath = path.replace(/^\/+|\/+$/g, "");
  return cleanPath ? `${base}${cleanPath}/` : base;
};
const robots = [
  { name: "Tangerine", year: "2026", slug: "tangerine" },
  { name: "C²", year: "2025", slug: "c2" },
  { name: "Clementune", year: "2024", slug: "clementune" },
  { name: "S.S. Squeeze", year: "2023", slug: "ss-squeeze" },
  { name: "SLICEasaurus Rex", year: "2022", slug: "sliceasaurus-rex" },
];
---

<GalleryLayout
  title="Robot Gallery"
  description="Explore the robots SLICE has designed, built, programmed, and competed with."
>
  <section class="grid grid-3">
    {robots.map((robot) => (
      <a class="card card-link" href={sitePath(`/robots/${robot.slug}`)}>
        <div class="image card-image">ROBOT PHOTO</div>
        <p class="eyebrow">{robot.year}</p>
        <h2>{robot.name}</h2>
        {/* PLACEHOLDER: one-line description of each robot */}
        <p class="muted">PLACEHOLDER description of {robot.name}.</p>
      </a>
    ))}
  </section>
</GalleryLayout>
