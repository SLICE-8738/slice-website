---
// sponsor-us.astro
// Sponsorship pitch page. No real sponsorship-tier dollar amounts
// were available from the old site (there's a "Tiers.png" graphic
// on the live site but its numbers can't be read from a text
// scrape) -- $ amounts below are PLACEHOLDER, but the tier
// structure (Title/Gold/Silver) matches slicerobotics.org.
//
// Cards are visually tiered (not just labeled) per feedback: the
// Title card is enlarged/highlighted with a badge, Gold sits in the
// middle, Silver is more understated -- see .tier-card styles in
// global.css.
import ActionsLayout from "../layouts/ActionsLayout.astro";
import "../styles/global.css";
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
// PLACEHOLDER $ amounts -- replace with the team's real sponsorship
// levels once the sponsorship packet numbers are available.
const tiers = [
  {
    name: "Title Sponsor",
    amount: "PLACEHOLDER $",
    tierClass: "tier-title",
    badge: "Top Tier",
    benefits: ["Logo on robot", "Logo on team shirts", "Website + social recognition", "Priority event invites"],
  },
  {
    name: "Gold Sponsor",
    amount: "PLACEHOLDER $",
    tierClass: "tier-gold",
    badge: null,
    benefits: ["Logo on team shirts", "Website recognition"],
  },
  {
    name: "Silver Sponsor",
    amount: "PLACEHOLDER $",
    tierClass: "tier-silver",
    badge: null,
    benefits: ["Website recognition"],
  },
];
---

<ActionsLayout
  title="Sponsor Us"
  description="Support SLICE Robotics and help fund our season."
>
  <section>
    <p class="lead">
      SLICE is run by Fuquay Varina Robotics Boosters, Inc., a
      501(c)(3) nonprofit organization. Every dollar donated is
      critical to our team achieving success and making our robot as
      competitive as possible.
    </p>
  </section>

  <section class="grid grid-3">
    {tiers.map((tier) => (
      <div class={`card tier-card ${tier.tierClass}`}>
        {tier.badge && <span class="tier-badge">{tier.badge}</span>}
        <p class="eyebrow">{tier.name}</p>
        <h3>{tier.amount}</h3>
        <ul class="list">
          {tier.benefits.map((benefit) => <li>{benefit}</li>)}
        </ul>
      </div>
    ))}
  </section>

  <section>
    <aside class="callout">
      <p class="eyebrow">Ready to Sponsor?</p>
      <h3>Get In Touch</h3>
      <p>
        <!-- PLACEHOLDER: link a real sponsorship packet/PDF here -->
        Reach out via our <a href={`${base}contact/`}>contact page</a> to
        discuss sponsorship, or to request our sponsorship packet.
      </p>
      <a class="button primary" href={`${base}contact/`}>Contact Us -></a>
    </aside>
  </section>
</ActionsLayout>
