---
// leadership.astro
// The old site's leadership page had no real member data scraped
// (just "Interested? This could be you"), so this is a placeholder
// grid of member cards -- swap in real names/roles/photos.
import MeetUsLayout from "../layouts/MeetUsLayout.astro";
import "../styles/global.css";
// PLACEHOLDER roster -- replace with real student leadership.
const leaders = [
  { role: "Team President", name: "PLACEHOLDER Name" },
  { role: "Engineering Lead", name: "PLACEHOLDER Name" },
  { role: "Business Lead", name: "PLACEHOLDER Name" },
  { role: "Programming Lead", name: "PLACEHOLDER Name" },
];
---

<MeetUsLayout
  title="Leadership"
  description="Meet the student leaders who run SLICE day to day."
>
  <section>
    <p class="lead">
      Our team is fully student-led, with mentors acting as
      resources and guides rather than running the show. Meet the
      students who help keep SLICE running.
    </p>
  </section>

  <section class="grid grid-3">
    {leaders.map((leader) => (
      <div class="card">
        <div class="image square">PHOTO</div>
        <p class="eyebrow">{leader.role}</p>
        <h3>{leader.name}</h3>
      </div>
    ))}
  </section>

  <section>
    <aside class="callout">
      <p class="eyebrow">Interested?</p>
      <h3>This Could Be You</h3>
      <p>
        Student leadership positions open up as members grow with
        the team. <a href={`${import.meta.env.BASE_URL}join`}>Join SLICE</a> to get started.
      </p>
    </aside>
  </section>
</MeetUsLayout>
