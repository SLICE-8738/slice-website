---
// about.astro -- "Who Are We?"
// Content adapted from the old site's who-are-we page.
import InfoLayout from "../layouts/InfoLayout.astro";
import "../styles/global.css";
// Subteam lists. PLACEHOLDER: the old site references "Engineering
// Subteams" and "Business Subteams" but the actual subteam names
// weren't pulled in -- fill these in with the real subteam names.
const engineeringSubteams = [
  "Mechanical -- PLACEHOLDER subteam name",
  "Electrical -- PLACEHOLDER subteam name",
  "Programming -- PLACEHOLDER subteam name",
  "CAD -- PLACEHOLDER subteam name",
];
const businessSubteams = [
  "Fundraising -- PLACEHOLDER subteam name",
  "Marketing/Branding -- PLACEHOLDER subteam name",
  "Outreach -- PLACEHOLDER subteam name",
];
---

<InfoLayout
  title="Who Are We?"
  description="SLICE is a student-led FIRST Robotics Competition team based in Fuquay-Varina, North Carolina."
>
  <section>
    <p>
      SLICE is a student-led FIRST Robotics Competition team. We
      strive to build STEM, business, and leadership in our
      community through innovation, competition, and service. It is
      our mission to work towards excellence every day.
    </p>
    <p>
      We are a student-led robotics team in Fuquay-Varina, North
      Carolina and a competitor in the FIRST&reg; Robotics
      Competition.
    </p>
  </section>

  <!-- =====================================================
       ENGINEERING + BUSINESS TEAMS
       ===================================================== -->
  <section>
    <p class="eyebrow">How We're Organized</p>
    <h2 class="section-title">Engineering &amp; Business Teams</h2>

    <div class="grid grid-2">
      <div class="card">
        <p class="eyebrow">Engineering</p>
        <h3>Engineering Teams</h3>
        <p class="muted">
          Our Engineering Teams work collaboratively to design,
          build, and program the robot for competition.
        </p>
        <ul class="list">
          {engineeringSubteams.map((subteam) => <li>{subteam}</li>)}
        </ul>
      </div>

      <div class="card">
        <p class="eyebrow">Business</p>
        <h3>Business Teams</h3>
        <p class="muted">
          Our Business Teams run service, fundraising, and team
          events, establish and design the team brand, earn
          sponsorships, and budget.
        </p>
        <ul class="list">
          {businessSubteams.map((subteam) => <li>{subteam}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- =====================================================
       WHY JOIN
       ===================================================== -->
  <section>
    <p class="eyebrow">Why Join SLICE?</p>
    <h2 class="section-title">Flexible and Thriving</h2>
    <p>
      Our team's youth in the FRC world means that we are still
      growing, and our policies aren't yet set in stone. We
      understand that the team changes every year, and because of
      that, the way the team functions will change every year too.
      If something isn't working, we're not afraid to change it.
    </p>
    <p>
      Our flexibility has served us well. We've earned a spot at the
      State Championship 4 times in 4 years, and made it to the
      World Championship 3 of those years. Our record is decorated
      with awards including Rookie All-Star, Industrial Design, and
      Imagery, topped off with our first blue banner (competition
      win), won in the 24-25 FRC season.
    </p>
    <p>
      Most importantly, we are dedicated to creating the best
      atmosphere possible for our team members. That begins with our
      student leaders -- our team is fully student-led to optimize
      the experience we're able to provide, with mentors acting as
      resources and guides. They're there to lend us their expertise
      and help us solve problems, not solve them for us.
    </p>
  </section>

  <!-- =====================================================
       MEETING INFO CALLOUT
       ===================================================== -->
  <section>
    <aside class="callout">
      <p class="eyebrow">Meetings</p>
      <h3>When &amp; Where We Meet</h3>
      <p>
        We meet in Fuquay-Varina, North Carolina --
        <a href="/contact">contact us</a> for schedule and location.
        New members are always welcome! Our season officially kicks
        off in January, but we're active year-round. We recommend
        joining before the start of the season so you can be trained
        on the subteam of your choosing. Our meetings run from
        2:30-3:30 in the offseason and 2:30-4:30 during build season
        -- though meeting days are subject to change.
      </p>
    </aside>
  </section>
</InfoLayout>
