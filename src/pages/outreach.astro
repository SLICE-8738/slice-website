---
// outreach.astro
// Content adapted from the old site's "Building the Future" and
// "MANifest" pages, presented as a card grid of outreach programs.
import GalleryLayout from "../layouts/GalleryLayout.astro";
import "../styles/global.css";
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
// Each entry is one outreach program/event. Text is condensed from
// the old site -- expand or trim as needed.
const programs = [
  {
    eyebrow: "FLL Mentoring",
    title: "Fuquay-Varina Middle School FLL Team",
    copy: "SLICE helped the Fuquay-Varina Middle School establish a FIRST LEGO League (FLL)team.  We helped them understand some of the rules that we, as an FRC team, follow.  As well as teach them more about the STEM world, like programming and engineering. The kids at the middle school asked questions freely so they could get a deeper understanding of what the team means and how to handle the team.  Shout out to the following Slice members that went to this incredible interactive event Julia Mikaelian, Mathew Morris, Rachel Stokes, Ally Russell, Julisa Mancia, Jacob, Kyne Starler, Therron, Jack Shindler, Ashton Poindexter",
  },
  {
    eyebrow: "FLL Mentoring",
    title: "Ballentine Elementary School FLL Team",
    copy: "Slice will be mentoring FLL teams at Ballentine Elementary School(BES), a local school in the area surrounding Fuquay-Varina High School. BES’s FIRST® LEGO® League program guides youth through STEM learning and exploration at an early age. Students will understand the basics of STEM and apply their skills in an exciting competition while building habits of learning, confidence, and teamwork skills along the way. We are excited to be a resource for the teams to use as they GLOW throughout their seasons like their school mascot the firefly. We hope to see members of these teams join Slice in the future.",
  },
  {
    eyebrow: "STEM Day",
    title: "STEM Day at Fuquay-Varina Middle School",
    copy: "Members of Slice built Lego EV3 robots for a STEM Day that will be held at Lincoln Heights Magnet Elementary School after AP Exams in May, we hope to start a new FLL program at Lincoln Heights after this event. We helped the Fuquay-Varina Middle School establish a Tech Challenge team.  We helped them understand some of the rules we as an FRC team follows. As well as teach them more about the STEM world like programming and engineering. The kids at the middle school asked questions freely so they can get a deeper understanding of what the team means and how to handle the team.",
  },
  {
    eyebrow: "Virtual Demo",
    title: "White Oak Elementary School",
    copy: "Members of Slice Rachel Stokes, Jack Schindler, Therron Mawyer, Kyne Starler, and Matthew Morris got on a GoogleMeet and demonstrated different apsects of robotics for members of a class at White Oak Elementary School early in the season. This included driving the robot, explaining different aspects of the electrical, mechanical, coding, business subteams, and the drive team. They sent us letters after our first competition at ECU thanking us for the demonstration and congratulating us on our performance. We are thankful for their support and look forward to potentially seeing them in robotics in the future!",
  },
  {
    eyebrow: "Community Service",
    title: "Miracle League",
    copy: "Members of Slice volunteered in two Miracle League(a baseball laeague for children and adults with special needs) games on 3/24/2022 acting as buddies to the players throughout their games, assisting in hitting, running the bases with them, warming up with the players, and assisting in the fielding",
  },
  {
    eyebrow: "Community Event",
    title: "South Lakes Elementary School 'Snow Day'",
    copy: "We helped the school set up an event called Snow Day on Dec 3rd, 2022. This event was set up for the families and kids of the South Lake. We helped them set up a snow station. Thanks to the help of SLICE members Alexa Stokes, Kyne and Brady Starler, Brody Heline, Mathew Morris,  and Jack Schindler.",
  },
];
---

<GalleryLayout
  title="Outreach"
  description="STEM outreach, community service, and events SLICE runs around Fuquay-Varina."
>
  <section class="grid grid-2">
    {programs.map((program) => (
      <article class="card leader-card" style="min-height: 800px;">
        <div class="image tall"><img src={`${base}images/outreach/${program.title.toLowerCase().replace(/ /g, "-")}.webp`} alt={program.title} /></div>
        <p class="eyebrow">{program.eyebrow}</p>
        <h3>{program.title}</h3>
        <p class="muted">{program.copy}</p>
      </article>
    ))}
  </section>
</GalleryLayout>
