---
// sliceasaurus-rex.astro -- individual robot page
import GalleryLayout from "../../layouts/GalleryLayout.astro";
import "../../styles/global.css";
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const robotSlug = "sliceasaurus-rex";
const heroBase = `${base}images/robots/${robotSlug}/hero`;
const galleryImages = [
  `${base}images/robots/${robotSlug}/photos/photo-1.png`,
  `${base}images/robots/${robotSlug}/photos/photo-2.png`,
  `${base}images/robots/${robotSlug}/photos/photo-3.png`,
  `${base}images/robots/${robotSlug}/photos/photo-4.png`,
  `${base}images/robots/${robotSlug}/photos/photo-5.png`,
  `${base}images/robots/${robotSlug}/photos/photo-6.png`,
];
const cadLink = "https://cad.onshape.com/documents/36240ea9b2c24898a924df7f/w/39480fdfca8c33353f371845/e/268d21c43bf94891f40bb27f?renderMode=0&uiState=6aaefea428baf3785b1fad03";
---

<GalleryLayout
  title="SLICEasaurus Rex"
  description="PLACEHOLDER one-line description of SLICEasaurus Rex, SLICE's 2026 competition robot."
>
  <article class="robot-page">
    <p class="eyebrow">2026 ROBOT</p>

    <div class="image" style="aspect-ratio: 16 / 9;">
      <img src={`${heroBase}/${robotSlug}-hero.jpg`} alt="SLICEasaurus Rex robot" style="height: 100%;" />
    </div>

    <section>
      <p class="eyebrow">Game Overview</p>
      <div class="grid grid-2">
        <div>
          <h2 class="section-title">The 2026 Game</h2>
          <img src={`${heroBase}/2026-logo.png`} alt="Rebuilt logo" style="width: 40%;" />
          <p>
            Rebuilt is the game for the 2026 FIRST Robotics Competition.
            Two alliances of three robots each work to score foam balls (called Fuel)
            into goals. At the end of the match,
            robots climb a ladder-like structure called the Tower to earn additional points.
            More information can be found on <a href="https://en.wikipedia.org/wiki/Rebuilt" target="_blank" rel="noopener noreferrer" style="color: var(--accent); text-decoration: underline;">Wikipedia</a>.
          </p>
        </div>
        <iframe width="100%" height="100%" src="https://www.youtube.com/embed/_fybREErgyM" title="FIRST Robotics Competition game animation" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
      </div>
    </section>

    <section>
      <p class="eyebrow">Stats</p>
      <h2 class="section-title">Quick Facts</h2>
      <div class="grid grid-3">
        <div class="stat">
          <div class="stat-number">113&thinsp;lbs</div>
          <div class="stat-label">Weight</div>
        </div>
        <div class="stat">
          <div class="stat-number">27.5&Prime;&times;27.5&Prime;</div>
          <div class="stat-label">Dimensions</div>
        </div>
        <div class="stat">
          <div class="stat-number">1&prime;&thinsp;10&Prime;</div>
          <div class="stat-label">Base Height</div>
        </div>
      </div>
    </section>

    <section>
      <p class="eyebrow">Gallery</p>
      <h2 class="section-title">Photos &amp; CAD</h2>
      <div class="robot-gallery">
        {galleryImages.map((image) => (
          <figure class="robot-gallery-item">
            <div class="image"><img src={image} alt="SLICEasaurus Rex gallery image" /></div>
          </figure>
        ))}
        <figure class="robot-gallery-item cad-card">
          <div class="cad-card-inner">
            <div class="cad-card-visuals">
              <div class="image"><img src={`${base}images/robots/${robotSlug}/cad/cad-1.png`} alt="SLICEasaurus Rex isometric CAD render" /></div>
              <div class="image"><img src={`${base}images/robots/${robotSlug}/cad/cad-2.png`} alt="SLICEasaurus Rex dynamic CAD render" /></div>
            </div>
            <a class="button primary" href={cadLink} target="_blank" rel="noopener noreferrer">View CAD Files</a>
          </div>
        </figure>
      </div>
    </section>

    <section>
      <p class="eyebrow">Results</p>
      <h2 class="section-title">Competition Results</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Event</th>
              <th>Rank</th>
              <th>Awards</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>FNC District Wake County Event #1</td>
              <td>13/29</td>
              <td>Quality Award</td>
            </tr>
            <tr>
              <td>FNC District Wake County Event #2</td>
              <td>12/29</td>
              <td>Creativity Award</td>
            </tr>
            <tr>
              <td>FIRST North Carolina State Championship</td>
              <td>19/52</td>
              <td>Imagery Award in honor of Jack Kamen</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </article>
</GalleryLayout>
