---
// sliceasaurus-rex.astro -- individual robot page
import GalleryLayout from "../../layouts/GalleryLayout.astro";
import "../../styles/global.css";
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<GalleryLayout
  title="SLICEasaurus Rex"
  description="PLACEHOLDER one-line description of SLICEasaurus Rex, SLICE's 2026 competition robot."
>
  <article class="robot-page">
    <p class="eyebrow">2026 ROBOT</p>

    <!-- Hero robot image -->
    <div class="image" style="aspect-ratio: 16 / 9;">
      <img src={`${base}images/robots/sliceasaurus-rex/sliceasaurus-rex-hero.jpg`} alt="SLICEasaurus Rex robot" style="height: 100%;" />
    </div>

    <!-- Game overview -->
    <section>
      <p class="eyebrow">Game Overview</p>
      <div class="grid grid-2">
        <div>
          <h2 class="section-title">The 2026 Game</h2>
          <img src={`${base}images/robots/sliceasaurus-rex/2026-logo.png`} alt="Rebuilt logo" style="width: 40%;" />
          <p>
            Rebuilt is the game for the 2026 FIRST Robotics Competition.
            Two alliances of three robots each work to score foam balls (called Fuel)
            into goals. At the end of the match,
            robots climb a ladder-like structure called the Tower to earn additional points.
            More information can be found on <a href="https://en.wikipedia.org/wiki/Rebuilt" target="_blank" rel="noopener noreferrer" style="color: var(--accent); text-decoration: underline;">Wikipedia</a>.
          </p>
        </div>
        <iframe width="100%" height="100%" src="https://www.youtube.com/embed/_fybREErgyM" title="FIRST Robotics Competition game animation" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
      </div>
    </section>

    <!-- Engineering sections -->
    <section>
      <p class="eyebrow">Engineering</p>
      <h2 class="section-title">How It Works</h2>
      <div class="grid grid-3">
        <div class="stat">
          <div class="stat-number">--</div>
          <div class="stat-label">Drivetrain</div>
        </div>
        <div class="stat">
          <div class="stat-number">--</div>
          <div class="stat-label">Mechanisms</div>
        </div>
        <div class="stat">
          <div class="stat-number">--</div>
          <div class="stat-label">Software</div>
        </div>
      </div>
    </section>

    <!-- Photos / CAD / specifications -->
    <section>
      <p class="eyebrow">Gallery</p>
      <h2 class="section-title">Photos &amp; CAD</h2>
    </section>

    <!-- Competition results -->
    <section>
      <p class="eyebrow">Results</p>
      <h2 class="section-title">Competition Results</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Event</th>
              <th>Rank</th>
              <th>Awards</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>FNC District Wake County Event #1</td>
              <td></td>
              <td>Quality Award</td>
            </tr>
            <tr>
              <td>FNC District Wake County Event #2</td>
              <td></td>
              <td>Creativity Award</td>
            </tr>
            <tr>
              <td>FIRST North Carolina State Championship</td>
              <td></td>
              <td>Imagery Award in honor of Jack Kamen</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </article>
</GalleryLayout>
