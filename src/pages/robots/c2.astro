---
// c2.astro -- individual robot page
import GalleryLayout from "../../layouts/GalleryLayout.astro";
import "../../styles/global.css";
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const robotSlug = "c2";
const heroBase = `${base}images/robots/${robotSlug}/hero`;
const galleryImages = [
  `${base}images/robots/${robotSlug}/photos/photo-1.svg`,
  `${base}images/robots/${robotSlug}/photos/photo-2.svg`,
  `${base}images/robots/${robotSlug}/photos/photo-3.svg`,
  `${base}images/robots/${robotSlug}/photos/photo-4.svg`,
  `${base}images/robots/${robotSlug}/photos/photo-5.svg`,
  `${base}images/robots/${robotSlug}/photos/photo-6.svg`,
];
const cadLink = `${base}images/robots/${robotSlug}/cad/`;
---

<GalleryLayout
  title="C²"
  description="PLACEHOLDER one-line description of C², SLICE's 2023 competition robot."
>
  <article class="robot-page">
    <p class="eyebrow">2023 ROBOT</p>

    <div class="image" style="aspect-ratio: 16 / 9;">
      <img src={`${heroBase}/${robotSlug}-hero.jpg`} alt="C² robot" style="height: 100%;" />
    </div>

    <section>
      <p class="eyebrow">Game Overview</p>
      <div class="grid grid-2">
        <div>
          <h2 class="section-title">The 2023 Game</h2>
          <img src={`${heroBase}/2023-logo.webp`} alt="Charged Up logo" style="width: 40%;" />
          <p>
            Charged Up is the game for the 2023 FIRST Robotics Competition.
            The game is themed around two alliances of three teams each who
            compete to bring energy to their community.
            Robots retrieve cones and cubes from substations, score them on the grid,
            and balance themselves on the charge station.
            More information can be found on <a href="https://en.wikipedia.org/wiki/Charged_Up_(FIRST_Robotics_Competition)" target="_blank" rel="noopener noreferrer" style="color: var(--accent); text-decoration: underline;">Wikipedia</a>.
          </p>
        </div>
        <iframe width="100%" height="100%" src="https://www.youtube.com/embed/0zpflsYc4PA" title="2026 FIRST Robotics Competition REBUILT Presented by Haas Game Animation" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
      </div>
    </section>

    <section>
      <p class="eyebrow">Stats</p>
      <h2 class="section-title">Quick Facts</h2>
      <div class="grid grid-4">
        <div class="stat">
          <div class="stat-number">--</div>
          <div class="stat-label">Weight</div>
        </div>
        <div class="stat">
          <div class="stat-number">--</div>
          <div class="stat-label">Dimensions</div>
        </div>
        <div class="stat">
          <div class="stat-number">--</div>
          <div class="stat-label">Base Height</div>
        </div>
        <div class="stat">
          <div class="stat-number">--</div>
          <div class="stat-label">Max Height</div>
        </div>
      </div>
    </section>

    <section>
      <p class="eyebrow">Gallery</p>
      <h2 class="section-title">Photos &amp; CAD</h2>
      <div class="robot-gallery">
        {galleryImages.map((image) => (
          <figure class="robot-gallery-item">
            <div class="image"><img src={image} alt="C² gallery image" /></div>
          </figure>
        ))}
        <figure class="robot-gallery-item cad-card">
          <div class="cad-card-inner">
            <div class="image"><img src={`${base}images/robots/${robotSlug}/cad/cad-1.svg`} alt="C² CAD render" /></div>
            <a class="button primary" href={cadLink} target="_blank" rel="noopener noreferrer">View CAD Files</a>
          </div>
        </figure>
      </div>
    </section>

    <section>
      <p class="eyebrow">Results</p>
      <h2 class="section-title">Competition Results</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Event</th>
              <th>Rank</th>
              <th>Awards</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>FNC District Johnston County Event</td>
              <td></td>
              <td>Autonomous Award</td>
            </tr>
            <tr>
              <td>FNC District UNC Pembroke Event</td>
              <td></td>
              <td>District Event Finalist</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </article>
</GalleryLayout>
