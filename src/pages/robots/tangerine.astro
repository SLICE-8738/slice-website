---
// tangerine.astro -- individual robot page
import GalleryLayout from "../../layouts/GalleryLayout.astro";
import "../../styles/global.css";
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<GalleryLayout
  title="Tangerine"
  description="PLACEHOLDER one-line description of Tangerine, SLICE's 2022 competition robot."
>
  <article class="robot-page">
    <p class="eyebrow">2022 ROBOT</p>

    <!-- Hero robot image -->
    <div class="image" style="aspect-ratio: 16 / 9;">
      <img src={`${base}images/robots/tangerine/tangerine-hero.jpg`} alt="Tangerine robot" style="height: 100%;" />
    </div>

    <!-- Game overview -->
    <section>
      <p class="eyebrow">Game Overview</p>
      <div class="grid grid-2">
        <div>
          <h2 class="section-title">The 2022 Game</h2>
          <img src={`${base}images/robots/tangerine/2022-logo.png`} alt="Rapid React logo" style="width: 40%;" />
          <p>
            Rapid React is the game for the 2022 FIRST Robotics Competition.
            The game is themed around transportation and involves two alliances
            consisting of three teams each competing to perform various tasks,
            including shooting balls known as Cargo into high and low hubs,
            and hanging on a series of rungs at the end of the match.
            More information can be found on <a href="https://en.wikipedia.org/wiki/Rapid_React" target="_blank" rel="noopener noreferrer" style="color: var(--accent); text-decoration: underline;">Wikipedia</a>.
          </p>
        </div>
        <iframe width="100%" height="100%" src="https://www.youtube.com/embed/LgniEjI9cCM" title="FIRST Robotics Competition game animation" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
      </div>
    </section>

    <!-- Engineering sections -->
    <section>
      <p class="eyebrow">Engineering</p>
      <h2 class="section-title">How It Works</h2>
      <div class="grid grid-3">
        <div class="card">
          <p class="eyebrow">Drivetrain</p>
          <h3>PLACEHOLDER</h3>
          <p class="muted">PLACEHOLDER -- describe the drivetrain.</p>
        </div>
        <div class="card">
          <p class="eyebrow">Mechanisms</p>
          <h3>PLACEHOLDER</h3>
          <p class="muted">PLACEHOLDER -- describe the scoring mechanism(s).</p>
        </div>
        <div class="card">
          <p class="eyebrow">Software</p>
          <h3>PLACEHOLDER</h3>
          <p class="muted">PLACEHOLDER -- describe autonomous/vision/controls.</p>
        </div>
      </div>
    </section>

    <!-- Photos / CAD / specifications -->
    <section>
      <p class="eyebrow">Gallery</p>
      <h2 class="section-title">Photos &amp; CAD</h2>
      <div class="grid grid-3">
        <div class="image">PHOTO</div>
        <div class="image">PHOTO</div>
        <div class="image">CAD RENDER</div>
      </div>
    </section>

    <!-- Competition results -->
    <section>
      <p class="eyebrow">Results</p>
      <h2 class="section-title">Competition Results</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Event</th>
              <th>Rank</th>
              <th>Awards</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>PLACEHOLDER</td>
              <td>PLACEHOLDER</td>
              <td>PLACEHOLDER</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </article>
</GalleryLayout>
