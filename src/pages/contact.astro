---
// contact.astro
// The old site's contact page had very little scraped text beyond
// the nonprofit boilerplate, so this page is mostly a placeholder
// form + info card built on the existing .form styles from
// global.css (see design.astro for the same pattern).
//
// BACKEND: this site deploys to GitHub Pages (see
// .github/workflows/astro.yml), which is static-hosting-only --
// there's no server to run a real POST handler on. The standard fix
// for a static site is a client-side form backend service; this
// wires the form up to Formspree (https://formspree.io) via fetch(),
// which is free for low volume and needs zero server code.
//
// TO ACTUALLY MAKE THIS WORK, see PATCH_NOTES.md for setup steps.
// Short version: create a free Formspree account, verify an inbox
// (start with benpark20@icloud.com for testing), create a form, and
// paste its endpoint into FORM_ENDPOINT below. When ready for the
// real site, create a second Formspree form verified against the
// team's business email and swap the endpoint again.
import ActionsLayout from "../layouts/ActionsLayout.astro";
import "../styles/global.css";
---

<ActionsLayout
  title="Contact"
  description="Have a question for SLICE Robotics? Reach out below."
>
  <section>
    <div class="grid grid-2">
      <div>
        <p class="lead">
          Questions about joining, sponsoring, or booking us for an
          outreach event? Send us a message and we'll get back to
          you.
        </p>
        <aside class="callout">
          <p class="eyebrow">Organization</p>
          <h3>Fuquay Varina Robotics Boosters, Inc.</h3>
          <p class="muted">A 501(c)(3) nonprofit organization.</p>
          <!-- PLACEHOLDER: add real address, email, phone here -->
          <p class="muted">
            PLACEHOLDER -- Fuquay-Varina, North Carolina
          </p>
        </aside>
      </div>

      <form action="https://api.web3forms.com/submit" method="POST">
        <input type="hidden" name="access_key" value="26aebce2-0fc0-483d-afa3-4523b373ed20">
        <input type="text" name="name" required>
        <input type="email" name="email" required>
        <textarea name="message" required></textarea>
        <button type="submit">Submit</button>
      </form>
    </div>
  </section>
</ActionsLayout>
