---
// contact.astro
// The old site's contact page had very little scraped text beyond
// the nonprofit boilerplate, so this page is mostly a placeholder
// form + info card built on the existing .form styles from
// global.css (see design.astro for the same pattern).
//
// BACKEND: this site deploys to GitHub Pages (see
// .github/workflows/astro.yml), which is static-hosting-only --
// there's no server to run a real POST handler on. The standard fix
// for a static site is a client-side form backend service; this
// wires the form up to Formspree (https://formspree.io) via fetch(),
// which is free for low volume and needs zero server code.
//
// TO ACTUALLY MAKE THIS WORK, see PATCH_NOTES.md for setup steps.
// Short version: create a free Formspree account, verify an inbox
// (start with benpark20@icloud.com for testing), create a form, and
// paste its endpoint into FORM_ENDPOINT below. When ready for the
// real site, create a second Formspree form verified against the
// team's business email and swap the endpoint again.
import ActionsLayout from "../layouts/ActionsLayout.astro";
import "../styles/global.css";
---

<ActionsLayout
  title="Contact"
  description="Have a question for SLICE Robotics? Reach out below."
>
  <section>
    <div class="grid grid-2">
      <div>
        <p class="lead">
          Questions about joining, sponsoring, or booking us for an
          outreach event? Send us a message and we'll get back to
          you.
        </p>
        <aside class="callout">
          <p class="eyebrow">Organization</p>
          <h3>Fuquay Varina Robotics Boosters, Inc.</h3>
          <p class="muted">A 501(c)(3) nonprofit organization.</p>
          <!-- PLACEHOLDER: add real address, email, phone here -->
          <p class="muted">
            PLACEHOLDER -- Fuquay-Varina, North Carolina
          </p>
        </aside>
      </div>

      <form id="contact-form" class="form" action="https://api.web3forms.com/submit" method="POST">
        <input type="hidden" name="access_key" value="26aebce2-0fc0-483d-afa3-4523b373ed20">
        <div class="field">
          <label for="name">Name</label>
          <input id="name" type="text" name="name" placeholder="Your name" required>
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" type="email" name="email" placeholder="you@example.com" required>
        </div>
        <div class="field">
          <label for="subject">Subject</label>
          <select id="subject" name="subject" required>
            <option value="" disabled selected>Choose a topic</option>
            <option value="Joining SLICE">Joining SLICE</option>
            <option value="Sponsorship">Sponsorship</option>
            <option value="Outreach Event">Outreach Event</option>
            <option value="General Question">General Question</option>
          </select>
        </div>
        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" placeholder="How can we help?" required></textarea>
        </div>
        <button class="button primary" type="submit">Send Message</button>
        <div class="form-status" role="status" aria-live="polite">
          <span class="form-status-message"></span>
          <button class="form-status-reset" type="button" hidden>Reset Form</button>
        </div>
      </form>
    </div>
  </section>
</ActionsLayout>

<script>
  const contactForm = document.querySelector<HTMLFormElement>("#contact-form");
  const formStatus = contactForm?.querySelector<HTMLDivElement>(".form-status");
  const formStatusMessage = contactForm?.querySelector<HTMLSpanElement>(".form-status-message");
  const resetButton = contactForm?.querySelector<HTMLButtonElement>(".form-status-reset");
  const submitButton = contactForm?.querySelector<HTMLButtonElement>("button[type='submit']");

  contactForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!formStatus || !formStatusMessage || !resetButton || !submitButton) return;

    submitButton.disabled = true;
    formStatus.className = "form-status";
    formStatusMessage.textContent = "Sending...";
    resetButton.hidden = true;

    try {
      const response = await fetch(contactForm.action, {
        method: contactForm.method || "POST",
        body: new FormData(contactForm),
        headers: { Accept: "application/json" },
      });

      if (!response.ok) throw new Error("Form submission failed");

      formStatus.className = "form-status visible success";
      formStatusMessage.textContent = "Thanks! Your message has been sent.";
      resetButton.hidden = false;
    } catch {
      formStatus.className = "form-status visible error";
      formStatusMessage.textContent = "Something went wrong. Please try again.";
    } finally {
      submitButton.disabled = false;
    }
  });

  resetButton?.addEventListener("click", () => {
    contactForm?.reset();
    formStatus?.classList.remove("visible", "success", "error");
    formStatusMessage?.replaceChildren();
    resetButton.hidden = true;
  });
</script>
