---
// calendar.astro
// Real Google Calendar embed, pulled from the live site's
// /calendar page (public calendar: business@slicerobotics.org).
import SingleElementLayout from "../layouts/SingleElementLayout.astro";
import "../styles/global.css";

const CALENDAR_SRC =
  "https://calendar.google.com/calendar/embed?src=business%40slicerobotics.org&ctz=America%2FNew_York";
---

<SingleElementLayout
  title="Calendar"
  description="Upcoming SLICE events, competitions, meetings, and outreach."
>
  <section>
    <div class="calendar-embed">
      <iframe
        src={CALENDAR_SRC}
        title="SLICE Robotics Calendar"
        loading="lazy"
      ></iframe>
    </div>
  </section>
</SingleElementLayout>
