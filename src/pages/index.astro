---
// index.astro -- Homepage
// Uses the base Layout (not one of the section layouts) since the
// homepage has its own hero instead of the shared page-header block.
import Layout from "../layouts/Layout.astro";
import Countdown from "../components/Countdown.astro";
import "../styles/global.css";
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const sitePath = (path: string) => {
  const cleanPath = path.replace(/^\/+|\/+$/g, "");
  return cleanPath ? `${base}${cleanPath}/` : base;
};
// Quick-links shown below the hero. Update hrefs/labels as the real
// site structure firms up.
const quickLinks = [
  { href: "/robots", eyebrow: "2026 Season", title: "Meet the Robot", copy: "See what we're building this season and how it works.", cta: "Explore Robots ->" },
  { href: "/outreach", eyebrow: "Outreach", title: "Community Impact", copy: "STEM outreach, demos, and events we run around Fuquay-Varina.", cta: "See Outreach ->" },
  { href: "/join", eyebrow: "Get Involved", title: "Join SLICE", copy: "New members are always welcome -- no experience required.", cta: "Join the Team ->" },
];
// PLACEHOLDER: real PayPal donate link/button ID. See PATCH_NOTES.md
// for how to wire this up to the team's actual PayPal account.
const DONATE_URL = "https://www.paypal.com/donate?token=o3mmMHhg5n8b5A1H1ck8d5j-zbc-gjwrcczY40beliWWUIrnmy_NFEjOO9aikf6ZdtMObzr_iinM-jc4";
// The 2027 FRC Kickoff (BIOCORE season) is confirmed for Jan 9, 2027
// at 12:00 PM ET -- a real date every FRC team counts down to. Swap
// this for SLICE's next competition date once it's locked in;
// see PATCH_NOTES.md.
const COUNTDOWN_TARGET = "2026-10-03T11:00:00.000Z"; // ISO 8601, e.g. "2027-01-09T12:00:00-05:00"
---
<style>
  html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    overflow-x: hidden; /* Prevents unwanted horizontal scrolling */
  }
  .hero {
  width: 100vw;
  position: relative;
  left: 50%;
  right: 50%;
  margin-left: -50vw;
  margin-right: -50vw;

  box-sizing: border-box;

    background-image: linear-gradient(90deg, rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.3)), var(--hero-image);
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center;
    padding: 20% 10%;
    color: #ffffff;
  }
  .hero .hero-copy {
    color: var(--text);
  }
  .mission-layout {
    grid-template-columns: minmax(0, 7fr) minmax(180px, 3fr);
    align-items: center;
  }
  .mission-logo {
    display: block;
    width: min(100%, 240px);
    height: auto;
    margin: 0 auto;
  }
  @media (max-width: 800px) {
    .mission-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
<Layout
  title="SLICE Robotics"
  description="SLICE is FRC Team 8738, a student-led robotics team based in Fuquay-Varina, North Carolina."
>
  <main class="page">
    <section class="hero" style={`--hero-image: url("${base}images/hero.png")`}>
      <div>
        <p class="eyebrow">FRC TEAM 8738</p>
        <h1>SLICE <span>ROBOTICS</span></h1>
        <p class="hero-copy">
          SLICE is a student-led robotics team based in
          Fuquay-Varina, North Carolina, competing in the FIRST
          Robotics Competition. We build STEM, business, and
          leadership in our community through innovation,
          competition, and service.
        </p>
        <div class="button-row">
          <a class="button" href={sitePath("/about")}>Who We Are</a>
          <a class="button" href={sitePath("/robots")}>See Our Robots</a>
          <a class="button" href={sitePath("/join")}>Join the Team</a>
          <a class="button primary" href={DONATE_URL} target="_blank" rel="noopener noreferrer">Donate -></a>
        </div>
      </div>
    </section>
    <!-- =====================================================
         MISSION STATEMENT
         ===================================================== -->
    <section>
      <div class="grid grid-2 mission-layout">
        <div>
          <p class="eyebrow">What Does SLICE Mean?</p>
          <h2 class="section-title">Our Mission</h2>
          <blockquote class="quote">
            <div class="mission-lines">
              <p><strong>Serve</strong> Our Community</p>
              <p>Become the <strong>Leaders</strong> of Our Future</p>
              <p><strong>Innovate</strong> Our Future</p>
              <p>Foster a great sense of <strong>Community</strong></p>
              <p>Show <strong>Excellence</strong> in Everything We Do</p>
              <p>It's all in our name—<strong>SLICE</strong>.</p>
            </div>
          </blockquote>
        </div>
        <div><img class="mission-logo" src={`${base}images/logo.webp`} alt="SLICE Robotics logo" /></div>
    </div>
  </section>
    <!-- =====================================================
         QUICK LINKS
         ===================================================== -->
    <section>
      <p class="eyebrow">Explore</p>
      <h2 class="section-title">Get to Know SLICE</h2>
      <p class="section-intro">
        A few places to start -- see what we build, what we do for
        our community, and how to get involved.
      </p>

      <div class="grid grid-3">
        {quickLinks.map((link) => (
          <a class="card card-link" href={sitePath(link.href)}>
            <p class="eyebrow">{link.eyebrow}</p>
            <h3>{link.title}</h3>
            <p class="muted">{link.copy}</p>
            <span class="button">{link.cta}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- =====================================================
         SUPPORT / DONATE
         ===================================================== -->
    <section>
      <aside class="callout">
        <p class="eyebrow">Support SLICE</p>
        <h3>Help Power Our Season</h3>
        <p class="muted">
          SLICE is run by Fuquay Varina Robotics Boosters, Inc., a
          501(c)(3) nonprofit organization. Every donation goes
          straight toward parts, tools, and travel to competition.
        </p>
        <div class="button-row">
          <a class="button primary" href={DONATE_URL} target="_blank" rel="noopener noreferrer">Donate -></a>
          <a class="button" href={sitePath("/sponsor-us")}>Become a Sponsor -></a>
        </div>
      </aside>
    </section>
    <!-- =====================================================
         COUNTDOWN
         ===================================================== -->
    <section>
      <Countdown label="Countdown to Southern Virginia Showdown" targetDate={COUNTDOWN_TARGET} doneMessage="Kickoff is here! 🍊" />
    </section>
  </main>
</Layout>
