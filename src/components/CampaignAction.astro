---
import type { CampaignButton } from "../config/campaigns";
import PayPalDonate from "./PayPalDonate.astro";

interface Props {
  action: CampaignButton;
}

const { action } = Astro.props;
---

{action.type === "paypal" ? (
  <span class="campaign-action">
    <PayPalDonate />
  </span>
) : action.type === "link" ? (
  <span class="campaign-action">
    <a class="campaign-action-link" href={action.href}>{action.label}</a>
  </span>
) : null}

<style>
  .campaign-action-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 6px 16px;
    border: 1px solid #070505;
    border-radius: var(--radius-button);
    background: #070505;
    color: #FFFFFF;
    font-size: .9rem;
    font-weight: 800;
    white-space: nowrap;
    transition: filter 160ms ease, transform 160ms ease;
  }

  .campaign-action {
    display: inline-flex;
    flex: 0 0 auto;
  }

  :global(.campaign-banner .paypal-donate .paypal-button) {
    width: auto;
    min-width: 0;
    height: auto;
    min-height: 38px;
    padding: 6px 12px;
  }

  .campaign-action-link:hover {
    filter: brightness(1.2);
    transform: translateY(-1px);
  }

  @media (prefers-reduced-motion: reduce) {
    .campaign-action-link {
      transition: none;
    }
  }

  @media (max-width: 700px) {
    :global(.campaign-banner .campaign-action-link) {
      min-height: 34px;
      padding: 5px 9px;
      font-size: .75rem;
    }

    :global(.campaign-banner .paypal-donate .paypal-button) {
      min-height: 34px;
      padding: 5px 9px;
    }

    :global(.campaign-banner .paypal-button-label) {
      font-size: .75rem;
    }
  }
</style>
