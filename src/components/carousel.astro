---
export interface CarouselImage {
	src: string;
	alt: string;
	href?: string;
}

interface Props {
	images: CarouselImage[];
	width?: string;
	height?: string;
	radius?: string;
	gap?: string;
	duration?: string;
    direction?: "ltr" | "rtl";
}

const {
	images,
	width = "280px",
	height = "180px",
	radius = "var(--radius-md)",
	gap = "16px",
	duration = "40s",
	direction = "rtl",
} = Astro.props;

const carouselStyle = `--carousel-width: ${width}; --carousel-height: ${height}; --carousel-radius: ${radius}; --carousel-gap: ${gap}; --carousel-duration: ${duration};`;
---

{images.length > 0 && (
	<div class="carousel" style={carouselStyle}>
		<div class:list={["carousel-track", { "carousel-track-ltr": direction === "ltr" }]} tabindex="0" aria-label="Image carousel">
			{[...images, ...images].map((image, index) => {
				const isDuplicate = index >= images.length;
				const slide = (
					<div class="carousel-slide" aria-hidden={isDuplicate ? "true" : undefined}>
						<img src={image.src} alt={isDuplicate ? "" : image.alt} loading="lazy" />
					</div>
				);

				if (image.href) {
					return (
						<a class="carousel-link" href={image.href} aria-label={image.alt} aria-hidden={isDuplicate ? "true" : undefined}>
							{slide}
						</a>
					);
				}

				return slide;
			})}
		</div>
	</div>
)}

<style>
	.carousel {
		position: relative;
		width: 100%;
		max-width: 100%;
		min-width: 0;
		margin: 24px auto;
		overflow: hidden;
	}

	.carousel::before,
	.carousel::after {
		position: absolute;
		top: 0;
		bottom: 0;
		z-index: 1;
		width: 5%;
		content: "";
		pointer-events: none;
		backdrop-filter: blur(1px);
	}

	.carousel::before {
		left: 0;
		background: linear-gradient(to right, var(--bg) 0%, color-mix(in srgb, var(--bg) 72%, transparent) 45%, transparent 100%);
	}

	.carousel::after {
		right: 0;
		background: linear-gradient(to left, var(--bg) 0%, color-mix(in srgb, var(--bg) 72%, transparent) 45%, transparent 100%);
	}

	.carousel-track {
		display: flex;
		width: max-content;
		gap: var(--carousel-gap);
		animation: carousel-scroll var(--carousel-duration) linear infinite;
	}

	.carousel-track-ltr {
		animation-name: carousel-scroll-ltr;
	}

	.carousel-link,
	.carousel-slide {
		flex: 0 0 var(--carousel-slide-width, var(--carousel-width));
		width: var(--carousel-slide-width, var(--carousel-width));
		height: var(--carousel-slide-height, var(--carousel-height));
		overflow: hidden;
		border-radius: var(--carousel-radius);
	}

	.carousel-link {
		display: block;
		text-decoration: none;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.carousel-link:hover,
	.carousel-link:focus-visible {
		transform: translateY(-2px);
		box-shadow: 0 14px 28px rgba(0, 0, 0, 0.22);
	}

	.carousel-slide img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	@keyframes carousel-scroll {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(calc(-50% - (var(--carousel-gap) / 2)));
		}
	}

	@keyframes carousel-scroll-ltr {
		from {
			transform: translateX(calc(-50% - (var(--carousel-gap) / 2)));
		}
		to {
			transform: translateX(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.carousel-track {
			animation: none;
		}
	}

	@media (max-width: 800px) {
		.carousel {
			margin: 16px auto;
		}

		.carousel-slide {
			--carousel-slide-width: min(var(--carousel-width), 72vw);
			--carousel-slide-height: min(var(--carousel-height), 48vw);
		}
	}
</style>
