---
// Footer.astro
// Reuses the .footer-grid / .footer-links classes from global.css.
// Link groups mirror the sitemap's dropdown groups (About Us /
// Our Team / Robots / Sponsors) rather than the old ad-hoc grouping.
//
// NOTE: like Header.astro, this intentionally does NOT link to
// /outreach or /awards -- those page files exist but aren't part of
// the sitemap the team provided.
//
// Instagram + YouTube URLs pulled from the live slicerobotics.org
// site (footer social links there).

const year = new Date().getFullYear();
const INSTAGRAM_URL = "https://www.instagram.com/slice_robotics/";
const YOUTUBE_URL = "http://www.youtube.com/@FVHSLICE8738";
const DONATE_URL = "https://www.paypal.com/US/fundraiser/charity/4533912";
const TIKTOK_URL = "https://www.tiktok.com/@slice_robotics?_r=1&_t=ZP-99l1HBc7Zni"
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const sitePath = (path: string) => {
  const cleanPath = path.replace(/^\/+|\/+$/g, "");
  return cleanPath ? `${base}${cleanPath}/` : base;
};
---
<footer>
  <div class="page footer-grid">
    <!-- Team blurb + logo -->
    <div>
      <div class="logo"><img src={`${base}images/logo-horizontal.png`} alt="SLICE Robotics Logo" style="width: 128px; height: auto;" /></div>
      <div class="social-links">
        <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" aria-label="SLICE Robotics on Instagram">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none" />
          </svg>
        </a>
        <a href={YOUTUBE_URL} target="_blank" rel="noopener noreferrer" aria-label="SLICE Robotics on YouTube">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <rect x="2.5" y="5.5" width="19" height="13" rx="4" />
            <path d="M10.5 9.5l5 2.5-5 2.5v-5z" fill="currentColor" stroke="none" />
          </svg>
        </a>
        <a href={TIKTOK_URL} target="_blank" rel="noopener noreferrer" aria-label="SLICE Robotics on tiktok">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M9 0h1.98c.144.715.54 1.617 1.235 2.512C12.895 3.389 13.797 4 15 4v2c-1.753 0-3.07-.814-4-1.829V11a5 5 0 1 1-5-5v2a3 3 0 1 0 3 3z" fill="currentColor" stroke="none" />
          </svg>
        </a>
        <a href={DONATE_URL} target="_blank" rel="noopener noreferrer" aria-label="Donate">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
             <path stroke="var(--muted)" stroke-linejoin="round" d="M6 1.5 3.5 18h4.02l0.984 -6.5h4.471a5 5 0 0 0 0 -10H6Z" stroke-width="1.5"></path>
              <path stroke="var(--muted)" stroke-linejoin="round" d="m9.337 6 -2.5 16.5h4l1 -6.5h4.475a5 5 0 0 0 0 -10H9.337Z" stroke-width="1.5"></path>
          </svg>
        </a>
      </div>
      <p class="muted">
        FRC Team 8738 -- a student-led robotics team based in
        Fuquay-Varina, North Carolina, competing in the FIRST
        Robotics Competition.
      </p>
      <p class="small">
        <!-- PLACEHOLDER: confirm this is the correct legal/parent org name -->
        Fuquay Varina Robotics Boosters, Inc. -- a 501(c)(3) nonprofit organization.
      </p>
    </div>

    <!-- Mirrors the "About Us" sitemap dropdown -->
    <div>
      <p class="eyebrow">About Us</p>
      <div class="footer-links">
        <a href={sitePath("/about")}>About Us</a>
        <a href={sitePath("/first")}>What is FIRST</a>
        <a href={sitePath("/join")}>Join Our Team</a>
      </div>
    </div>

    <!-- Mirrors the "Our Team" + "Robots" sitemap dropdowns -->
    <div>
      <p class="eyebrow">Our Team</p>
      <div class="footer-links">
        <a href={sitePath("/leadership")}>Leadership</a>
        <a href={sitePath("/mentors")}>Mentors</a>
        <a href={sitePath("/robots")}>Robots</a>
        <a href={sitePath("/calendar")}>Calendar</a>
      </div>
    </div>

    <!-- Mirrors the "Sponsors" sitemap dropdown + Contact -->
    <div>
      <p class="eyebrow">Sponsors</p>
      <div class="footer-links">
        <a href={sitePath("/sponsors")}>Current Sponsors</a>
        <a href={sitePath("/sponsor-us")}>Sponsor Us</a>
        <a href={sitePath("/contact")}>Contact Us</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-bottom {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }
  a {
    color: var(--muted);
  }
  a:hover {
    color: white;
  }
</style>
