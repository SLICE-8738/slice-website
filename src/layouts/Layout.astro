---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CampaignPromotions from "../components/CampaignPromotions.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "SLICE Robotics",
  description = "SLICE Robotics — FRC Team 8738",
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Tab-bar / bookmark icons generated from the real SLICE logo. -->
    <link rel="icon" type="image/x-icon" href={`${base}favicon.ico`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}favicon-16x16.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <meta name="theme-color" content="#070505" />
  </head>

  <body>
    <div class="site-chrome">
      <CampaignPromotions />
      <Header />
    </div>

    <slot />

    <Footer />
  </body>
</html>

<style>
  .site-chrome {
    position: sticky;
    top: 0;
    z-index: 15;
  }
  .site-chrome :global(.nav) {
    position: relative;
    top: auto;
  }
</style>